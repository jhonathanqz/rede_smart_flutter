# O .pubignore substitui o .gitignore na publicação: repetir aqui o que não deve ir para o pacote.
# O código-fonte de android/native é publicado (open source); os binários de android/libs também,
# pois são eles que o build do plugin usa.

# Segredos e arquivos locais
example/Chaves/
*.jks
*.keystore
**/local.properties
local.properties
key.properties
senha.txt
.env*

# Gerados
.dart_tool/
build/
**/build/
.gradle/
**/.gradle/
.idea/
**/.idea/
.cxx/
*.iml
.DS_Store
.flutter-plugins
.flutter-plugins-dependencies
*.hprof
.fvm/
fvm*
doc/
pubspec.lock
example/ios/Flutter/ephemeral/
